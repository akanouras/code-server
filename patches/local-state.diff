+
+interface RemoteStorageOptions {
+	id: string;
+	baseUrl: string;
+}
+
+export class RemoteStorageDatabase extends Disposable implements IIndexedDBStorageDatabase {
+
+	private readonly _onDidChangeItemsExternal = this._register(new Emitter<IStorageItemsChangeEvent>());
+	readonly onDidChangeItemsExternal = this._onDidChangeItemsExternal.event;
+
+	private readonly _onDidChangeStorage = this._register(new Emitter<IStorageItemsChangeEvent>());
+	readonly onDidChangeStorage = this._onDidChangeStorage.event;
+
+	private items = new Map<string, string>();
+	private revision = 0;
+	private ws: WebSocket | undefined;
+	private pendingUpdates: IUpdateRequest[] = [];
+	private isInitialized = false;
+
+	get hasPendingUpdate(): boolean {
+		return this.pendingUpdates.length > 0;
+	}
+
+	readonly name: string;
+
+	constructor(
+		private readonly options: RemoteStorageOptions,
+		private readonly logService: ILogService
+	) {
+		super();
+		this.name = `remote-${options.id}`;
+
+		this.initialize();
+	}
+
+	private async initialize(): Promise<void> {
+		try {
+			// Fetch initial state
+			const response = await fetch(`${this.options.baseUrl}/storage/${this.options.id}`, {
+				credentials: 'include'
+			});
+			if (response.ok) {
+				const data = await response.json();
+				const serverItems = new Map(Object.entries(data.items || {}));
+
+				// Check if we need to migrate from IndexedDB
+				if (serverItems.size === 0) {
+					await this.checkAndMigrateFromIndexedDB();
+				}
+
+				// Re-fetch after potential migration
+				const updatedResponse = await fetch(`${this.options.baseUrl}/storage/${this.options.id}`, {
+					credentials: 'include'
+				});
+				if (updatedResponse.ok) {
+					const updatedData = await updatedResponse.json();
+					this.items = new Map(Object.entries(updatedData.items || {}));
+					this.revision = updatedData.revision || 0;
+				}
+
+				this.isInitialized = true;
+				this._onDidChangeStorage.fire({ changed: this.items, deleted: new Set() });
+			} else {
+				this.logService.error(`Failed to fetch initial storage for ${this.options.id}: ${response.status}`);
+			}
+
+			// Connect to WebSocket for live updates
+			this.connectWebSocket();
+		} catch (error) {
+			this.logService.error(`Failed to initialize remote storage for ${this.options.id}:`, error);
+		}
+	}
+
+	private async checkAndMigrateFromIndexedDB(): Promise<void> {
+		try {
+			// Try to get data from IndexedDB
+			const indexedDB = await IndexedDB.create(`vscode-web-state-db-${this.options.id}`, undefined, ['ItemTable']);
+			const indexedDBItems = await indexedDB.getKeyValues('ItemTable', (value: unknown): value is string => typeof value === 'string');
+
+			if (indexedDBItems.size > 0) {
+				// Show migration notification
+				this.showMigrationNotification(indexedDBItems);
+			}
+		} catch (error) {
+			// IndexedDB might not exist or be accessible, ignore
+			this.logService.trace(`No IndexedDB data found for ${this.options.id}`);
+		}
+	}
+
+	private showMigrationNotification(indexedDBItems: Map<string, string>): void {
+		// For now, we'll automatically migrate. In a full implementation,
+		// this would show a workbench notification with export option
+		this.logService.info(`Migrating ${indexedDBItems.size} items from IndexedDB to server storage for ${this.options.id}`);
+
+		// Perform the migration
+		this.performMigration(indexedDBItems);
+	}
+
+	private async performMigration(indexedDBItems: Map<string, string>): Promise<void> {
+		try {
+			const response = await fetch(`${this.options.baseUrl}/storage/${this.options.id}/batch`, {
+				method: 'POST',
+				headers: { 'Content-Type': 'application/json' },
+				credentials: 'include',
+				body: JSON.stringify({
+					insert: Object.fromEntries(indexedDBItems),
+					delete: [],
+					lastSeenRevision: 0
+				})
+			});
+
+			if (response.ok) {
+				this.logService.info(`Successfully migrated ${indexedDBItems.size} items to server storage for ${this.options.id}`);
+			} else {
+				this.logService.error(`Failed to migrate items to server storage for ${this.options.id}: ${response.status}`);
+			}
+		} catch (error) {
+			this.logService.error(`Migration failed for ${this.options.id}:`, error);
+		}
+	}
+
+	private connectWebSocket(): void {
+		try {
+			const wsUrl = this.options.baseUrl.replace(/^http/, 'ws') + `/storage/changes/${this.options.id}`;
+			this.ws = new WebSocket(wsUrl);
+
+			this.ws.onmessage = (event) => {
+				try {
+					const data = JSON.parse(event.data);
+					if (data.bucket === this.options.id) {
+						// For WS changes, we need to refetch the current state since we don't get the new values
+						// This is a simplification; in a full implementation, the server could send the new values
+						this.refreshItems();
+					}
+				} catch (error) {
+					this.logService.error(`Failed to parse WS message for ${this.options.id}:`, error);
+				}
+			};
+
+			this.ws.onclose = () => {
+				// Reconnect after a delay
+				setTimeout(() => this.connectWebSocket(), 5000);
+			};
+
+			this.ws.onerror = (error) => {
+				this.logService.error(`WS error for ${this.options.id}:`, error);
+			};
+		} catch (error) {
+			this.logService.error(`Failed to connect WS for ${this.options.id}:`, error);
+		}
+	}
+
+	private async refreshItems(): Promise<void> {
+		try {
+			const response = await fetch(`${this.options.baseUrl}/storage/${this.options.id}`, {
+				credentials: 'include'
+			});
+			if (response.ok) {
+				const data = await response.json();
+				const newItems = new Map(Object.entries(data.items || {}).map(([k, v]) => [k, String(v)]));
+				const oldItems = new Map(this.items);
+
+				// Find changes
+				const changed = new Map<string, string>();
+				const deleted = new Set<string>();
+
+				for (const [key, value] of newItems) {
+					if (!oldItems.has(key) || oldItems.get(key) !== value) {
+						changed.set(key, value);
+					}
+				}
+
+				for (const key of oldItems.keys()) {
+					if (!newItems.has(key)) {
+						deleted.add(key);
+					}
+				}
+
+				this.items = newItems;
+				this.revision = data.revision || 0;
+
+				if (changed.size > 0 || deleted.size > 0) {
+					this._onDidChangeStorage.fire({ changed, deleted });
+				}
+			}
+		} catch (error) {
+			this.logService.error(`Failed to refresh items for ${this.options.id}:`, error);
+		}
+	}
+
+	async getItems(): Promise<Map<string, string>> {
+		// Wait for initialization if not ready
+		if (!this.isInitialized) {
+			await new Promise(resolve => {
+				const check = () => {
+					if (this.isInitialized) {
+						resolve(void 0);
+					} else {
+						setTimeout(check, 100);
+					}
+				};
+				check();
+			});
+		}
+		return new Map(this.items);
+	}
+
+	async updateItems(request: IUpdateRequest): Promise<void> {
+		// Add to pending updates
+		this.pendingUpdates.push(request);
+
+		// Debounce the actual send
+		this.scheduleSend();
+	}
+
+	private scheduleSend(): void {
+		if (this.sendTimeout) {
+			clearTimeout(this.sendTimeout);
+		}
+		this.sendTimeout = setTimeout(() => this.sendPendingUpdates(), 300);
+	}
+
+	private sendTimeout: any;
+
+	private async sendPendingUpdates(): Promise<void> {
+		if (this.pendingUpdates.length === 0) {
+			return;
+		}
+
+		const updates = [...this.pendingUpdates];
+		this.pendingUpdates = [];
+
+		try {
+			// Merge all pending updates
+			const merged: IUpdateRequest = { insert: new Map(), delete: new Set() };
+			for (const update of updates) {
+				if (update.insert) {
+					for (const [key, value] of update.insert) {
+						merged.insert!.set(key, value);
+					}
+				}
+				if (update.delete) {
+					for (const key of update.delete) {
+						merged.delete!.add(key);
+					}
+				}
+			}
+
+			const response = await fetch(`${this.options.baseUrl}/storage/${this.options.id}/batch`, {
+				method: 'POST',
+				headers: { 'Content-Type': 'application/json' },
+				credentials: 'include',
+				body: JSON.stringify({
+					insert: Object.fromEntries(merged.insert || []),
+					delete: Array.from(merged.delete || []),
+					lastSeenRevision: this.revision
+				})
+			});
+
+			if (response.ok) {
+				const data = await response.json();
+				this.revision = data.newRevision;
+
+				// Update local items
+				if (merged.insert) {
+					for (const [key, value] of merged.insert) {
+						this.items.set(key, value);
+					}
+				}
+				if (merged.delete) {
+					for (const key of merged.delete) {
+						this.items.delete(key);
+					}
+				}
+
+				this._onDidChangeStorage.fire({ changed: merged.insert || new Map(), deleted: merged.delete || new Set() });
+			} else {
+				this.logService.error(`Failed to send storage updates for ${this.options.id}: ${response.status}`);
+				// Re-queue the updates
+				this.pendingUpdates.unshift(...updates);
+			}
+		} catch (error) {
+			this.logService.error(`Failed to send storage updates for ${this.options.id}:`, error);
+			// Re-queue the updates
+			this.pendingUpdates.unshift(...updates);
+		}
+	}
+
+	async optimize(): Promise<void> {
+		// Not supported for remote storage
+	}
+
+	async close(): Promise<void> {
+		if (this.ws) {
+			this.ws.close();
+		}
+		if (this.sendTimeout) {
+			clearTimeout(this.sendTimeout);
+		}
+		// Send any pending updates
+		await this.sendPendingUpdates();
+	}
+
+	async clear(): Promise<void> {
+		// Clear local items
+		this.items.clear();
+		this.revision = 0;
+		this._onDidChangeStorage.fire({ changed: new Map(), deleted: new Set(this.items.keys()) });
+	}
+}
